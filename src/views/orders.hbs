// Utility: Validate a single field
function validateField(input) {
    const value = input.value.trim();
    const errorSpan = input.nextElementSibling;
    let isValid = true;

    if (input.id === "newOrderId" && !value) {
        showError(input, "Order ID is required.");
        isValid = false;
    } else if (input.id === "newOrderName" && !value) {
        showError(input, "Customer name is required.");
        isValid = false;
    } else if (input.id === "newOrderDate" && !value) {
        showError(input, "Order date is required.");
        isValid = false;
    } else if (input.id === "newOrderAddress" && !value) {
        showError(input, "Address is required.");
        isValid = false;
    } else if (input.id === "newOrderStatus" && !value) {
        showError(input, "Order status is required.");
        isValid = false;
    } else if (input.id === "newOrderContactNumber" && (!/^\d+$/.test(value) || value.length < 10 || value.length > 15)) {
        showError(input, "Contact number must be 10-15 digits.");
        isValid = false;
    } else if (input.id === "newOrderEmail" && !validateEmail(value)) {
        showError(input, "A valid email address is required.");
        isValid = false;
    } else {
        clearError(input); // Clear error if valid
    }

    return isValid;
}

