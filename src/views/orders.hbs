    function viewOrder(id){
        console.log(orders);
        for (let i = 0; i < orders.length; i++){
            if (orders[i]._id == id){
                document.getElementById('viewOrderId').innerHTML = orders[i].orderNumber;
                document.getElementById('viewOrderDate').innerHTML = formatDate(orders[i].orderDate);
                document.getElementById('viewOrderCustomer').innerHTML = orders[i].customer;
                document.getElementById('viewOrderAddress').innerHTML = orders[i].address;
                document.getElementById('viewOrderEmail').innerHTML = orders[i].email;
                document.getElementById('viewOrderContactNumber').innerHTML = orders[i].contact;
                document.getElementById('viewOrderStatus').innerHTML = orders[i].status;

                for (let j = 0; j < orders[i].items.length ; j++){
                    if (orders[i].items[j].stockNumber == 0){
                        continue;
                    }
                    const productName = lookName(orders[i].items[j].productId);
                    const initialProductPrice = lookPrice(orders[i].items[j].productId);

                    const productPrice = orders[i].items[j].stockNumber * initialProductPrice;

                    const row = `
                        <div id="container${orders[i].orderNumber}"class="flex justify-between">
                            <div class="min-w-[220px] max-w-[220px] text-left">
                                <p>${productName}</p>
                            </div>
                            <div class="min-w-[68px] max-w-[68px] text-center">
                                <p>${orders[i].items[j].stockNumber}</p>
                            </div>
                            <div class="min-w-[134px] max-w-[134px] text-right">
                                <p>₱${productPrice}</p>
                            </div>
                        </div>
                    `
                    
                    document.getElementById('itemsContainer').innerHTML += row;
                }

                document.getElementById('viewOrderTotalPrice').innerHTML = ('₱' + orders[i].totalPrice);
            }
        }
        document.getElementById('viewOrder').classList.remove('hidden');
    }

