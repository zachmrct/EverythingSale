{{> newnavbar}}
<div class="z-10 bg-white w-full h-full  rounded-[45px] p-10">
    <div class=" mx-auto">
    
    <!-- Header Section -->
    <div class="mb-6">
      <h1 class="text-4xl font-bold my-2">Welcome back, {{user.username}}!</h1>
      <p class="text-2xl text-gray-500">{{currentDate}}</p>
    </div>

    <div class="max-w-4xl w-full h-full grid grid-cols-1 md:grid-cols-3 gap-6">

    <!-- Orders Section -->
    <div class="md:col-span-2 bg-yellow-100 rounded-lg p-6 relative max-h-[400px] w-[700px] overflow-y-auto transition-transform transform hover:scale-105 hover:shadow-xl">
      <h2 class="text-pink-600 font-semibold text-xl mb-4">
        {{filteredOrders.length}} orders available!
      </h2>
      <ul class="space-y-4 overflow-y-auto max-h-32">
        {{#each filteredOrders}}
          <li class="bg-white rounded-lg  shadow-md p-4 hover:shadow-lg transition-transform duration-200 group">
            <div class="flex justify-between items-center">
              <!-- Left Section -->
              <div>
                <p class="text-gray-800 font-bold text-lg group-hover:text-blue-600">{{this.customer}}</p>
                <p class="text-gray-600 text-sm">Order #{{this.orderNumber}}</p>
                <p class="text-gray-500 text-sm">
                  
                </p>
              </div>
              <!-- Right Section -->
              <div class="text-right">
                <p class="text-gray-700 text-sm font-medium group-hover:text-green-600">Total: ${{this.totalPrice}}</p>
                <p class="text-gray-500 text-xs">Date: {{ formatDate this.orderDate }}</p>
              </div>
            </div>
          </li>
        {{/each}}
      </ul>
    </div>


     
  </div>

    <!-- Monthly Top Product Section -->
    <div class="mt-6">
    <h2 class="text-4xl font-bold mb-4">Monthly Top Product</h2>
    <div class="flex items-center space-x-4">
      
      <!-- Product Image -->
      
      <!-- The image will now fill the container, maintaining its aspect ratio -->

      <div class="w-80 h-[180px] bg-cover rounded-lg transition-transform transform hover:scale-105 hover:shadow-lg relative" style="background-image: url('https://via.placeholder.com/200');">
        <!-- Product Name (Positioned in front) -->
        <div class="text-black font-bold p-2 absolute top-0 left-0 z-30">{{productName}}</div>
        
        <!-- Product Image -->
        <img id="product-image" 
            src="../uploads/products/{{productPic}}" 
            alt="Product Image" 
            class="w-full h-full object-cover rounded-lg">
      </div>
      <!-- Earnings Button -->
      <div class="text-pink-600 font-bold text-lg bg-pink-100 rounded-lg px-4 py-2 transition-transform transform hover:scale-105 hover:shadow-md">
        P {{totalCostEarned}} earned
      </div>
    </div>
  </div>
    
    <!-- Stats Cards  -->
    <div class="space-y-4 flex flex-col justify-center absolute top-[60px] right-[150px] p-3 h-[75vh]">
      <div class="bg-white rounded-lg border-2 shadow-md p-6 text-center flex-grow flex flex-col justify-center h-[100px] duration-100 hover:scale-105 ">
        <p class="text-2xl font-bold text-gray-800">{{numberOfOrdersThisWeek}}</p>
        <p class="text-gray-500 text-xl">Weekly orders</p>
      </div>
      <div class="bg-white rounded-lg border-2 shadow-md p-6 text-center flex-grow flex flex-col justify-center h-[100px] duration-100 hover:scale-105">
        <p class="text-2xl font-bold text-gray-800">{{countStock products}}</p>
        <p class="text-gray-500 text-xl">Products-in-stock</p>
      </div>
      <div class="bg-white rounded-lg border-2 shadow-md p-6 text-center flex-grow flex flex-col justify-center h-[100px] duration-100 hover:scale-105">
        <p class="text-2xl font-bold text-gray-800">{{countCollection collections}}</p>
        <p class="text-gray-500 text-xl">Collections</p>
      </div>
    </div>
  </div>
</div>
