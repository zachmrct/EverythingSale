<div id="sidebar" class="w-[278px] h-full bg-[#897198] pt-[60px] transition-transform duration-300 relative">
    <!-- Close Button -->
    <button id="closeBtn" class="absolute top-4 right-4 text-white cursor-pointer">
        <i class="bi bi-x-lg"></i>
    </button>

    <!-- Profile Picture Holder -->
    <div class="flex flex-col items-center">
            <img src="/uploads/users/{{user.profilePicture}}" class="text-[#497EE4] text-[24px] font-bold w-[135px] h-[135px] rounded-full border-4 border-white flex items-center justify-center">
            <div class="lexend font-[700] text-white text-[24px] m-5 p-4 border-2 rounded-lg shadow-lg  ">
                {{user.username}}
            </div>
            

        <!-- Sidebar Links -->
        <div class="flex flex-col w-[278px] space-y-[10px]">
            <div id="dashboard" class="group bg-transparent flex pl-[49px] ml-4 w-full h-[42px] items-center hover:bg-white hover:drop-shadow-md hover:z-0 cursor-pointer rounded-l-lg">
                <a href="/" id="dashboardLabel" class="lexend font-[700] text-white text-[24px] group-hover:text-[#E98484]">Dashboard</a>
            </div>
            <div id="products" class="group bg-transparent flex pl-[49px] ml-4 bg-[#F6F296] w-full h-[42px] items-center hover:bg-white hover:drop-shadow-md hover:z-0 cursor-pointer rounded-l-lg">
                <a href="/products" id="productsLabel" class="lexend font-[700] text-white text-[24px] group-hover:text-[#E98484]">Products</a>
            </div>
            <div id="orders" class="group bg-transparent flex pl-[49px] ml-4 bg-[#F6F296] w-full h-[42px] items-center hover:bg-white hover:drop-shadow-md hover:z-0 cursor-pointer rounded-l-lg">
                <a href="/orders" id="ordersLabel" class="lexend font-[700] text-white text-[24px] group-hover:text-[#E98484]">Orders</a>
            </div>
            <div id="collections" class="group bg-transparent flex pl-[49px] ml-4 bg-[#F6F296] w-full h-[42px] items-center hover:bg-white hover:drop-shadow-md hover:z-0 cursor-pointer rounded-l-lg">
                <a href="/collections" id="collectionsLabel" class="lexend font-[700] text-white text-[24px] group-hover:text-[#E98484]">Collections</a>
            </div>
            <div id="users" class="group bg-transparent flex pl-[49px] ml-4 bg-[#F6F296] w-full h-[42px] items-center hover:bg-white hover:drop-shadow-md hover:z-0 cursor-pointer rounded-l-lg">
                <a href="/users" id="usersLabel" class="lexend font-[700] text-white text-[24px] group-hover:text-[#E98484]">Users</a>
            </div>
            <form id="logout" action="/logout" method="get" class="group bg-transparent flex pl-[49px] ml-4 bg-[#F6F296] w-full h-[42px] items-center hover:bg-white hover:drop-shadow-md hover:z-0 cursor-pointer rounded-l-lg">
                <button id="logoutLabel" type="submit" class="lexend font-[700] text-white text-[24px] group-hover:text-[#E98484]">Log Out</button>
            </form>
            
        </div>
    </div>

    
</div>

<!-- Pop-up Button -->
<button 
    id="showSidebarBtn" 
    class="hidden fixed left-5 top-1/2 transform -translate-y-1/2 bg-gradient-to-r from-[#E98484] to-[#FF6B6B] text-white font-extrabold rounded-full w-16 h-16 flex items-center justify-center shadow-lg z-20 transition duration-300 ease-in-out transform hover:scale-105 hover:shadow-2xl"
>
    <i class="bi bi-arrow-right"></i> <!-- Add an icon (make sure Bootstrap Icons are included) -->
</button>

<script src="/scripts/navbar.js"></script>